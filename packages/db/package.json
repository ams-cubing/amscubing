{
  "name": "@workspace/db",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./notifications": "./src/notifications.ts",
    "./mentions": "./src/mentions.ts",
    "./board-readiness": "./src/board-readiness.ts",
    "./utils": "./src/utils.ts",
    "./data/mexico": "./src/data/mexico.ts",
    "./data/delegates": "./src/data/delegates.ts",
    "./data/ams-board-template": "./src/data/ams-board-template.ts",
    "./seed-board-template": "./src/seed-board-template.ts",
    "./clone-board": "./src/clone-board.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed-template": "tsx src/seed-template.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.5",
    "eslint": "catalog:",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
