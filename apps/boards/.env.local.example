# App-specific variables (copy to .env.local)
# DATABASE_URL can also live in the repo root .env.local

DATABASE_URL=postgresql://ams:ams@localhost:5432/amscubing

# Must match web — OAuth + session cookies are issued by the public web app
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars

WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

NEXT_PUBLIC_CALENDAR_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_BOARDS_URL=http://localhost:3002

# Primary source: /admin/tableros (DB allowlist). Temporary additive override:
# comma-separated WCA IDs (server-only). Prefer managing via admin.
# Delegates always allowed. Empty DB + empty env = organizers blocked.
# BOARDS_ORGANIZER_ALLOWLIST=2016TORO03,2017ABCD01

# Email notifications (same key as calendar app)
RESEND_API_KEY=

# Production only — must match calendar
# AUTH_COOKIE_DOMAIN=.amscubing.org
