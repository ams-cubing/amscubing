# App-specific variables (copy to .env.local)
# DATABASE_URL can also live in the repo root .env.local

DATABASE_URL=postgresql://ams:ams@localhost:5432/amscubing

# Must match calendar — OAuth + session cookies are issued by the calendar app
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars

WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

NEXT_PUBLIC_CALENDAR_URL=http://localhost:3001
NEXT_PUBLIC_BOARDS_URL=http://localhost:3002

# Email notifications (same key as calendar app)
RESEND_API_KEY=

# Production only — must match calendar
# AUTH_COOKIE_DOMAIN=.amscubing.org
