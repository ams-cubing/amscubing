# Referencia de variables de entorno del monorepo.
# Cada app valida las suyas al arrancar (`apps/*/instrumentation.ts` con
# `@workspace/server/env`). Copia lo que necesites a `.env.local` en la raíz
# o a `apps/<app>/.env.local`; las apps leen su propio `.env.local` y
# `@workspace/db` usa el de la raíz como respaldo para DATABASE_URL.

# --- Base de datos (todas las apps) — obligatoria siempre ---
DATABASE_URL=postgresql://ams:ams@localhost:5432/amscubing

# --- Auth compartida (todas las apps) — obligatorias en producción ---
# El host canónico de auth es la web (OAuth + /api/auth).
BETTER_AUTH_URL=http://localhost:3000
# Mínimo 32 caracteres; el mismo valor en todas las apps.
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-chars
# Solo producción: comparte cookies entre subdominios.
# AUTH_COOKIE_DOMAIN=.amscubing.org
# Solo desarrollo: guarda en disco los correos de auth en lugar de enviarlos.
# AUTH_DEV_MAIL_DIR=

# --- URLs públicas de las apps (todas) — WEB/CALENDAR/BOARDS obligatorias en producción ---
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CALENDAR_URL=http://localhost:3001
NEXT_PUBLIC_BOARDS_URL=http://localhost:3002
NEXT_PUBLIC_COURSES_URL=http://localhost:3003
NEXT_PUBLIC_BLOG_URL=http://localhost:3004

# --- OAuth WCA (web) — obligatorias en producción ---
# Callback local: http://localhost:3000/api/auth/callback/wca
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# --- Correo con Resend (web, calendar, boards) — opcional ---
# Sin clave, los envíos se omiten con un aviso en el log.
RESEND_API_KEY=

# --- UploadThing (blog, boards) — opcional ---
# Necesaria para subir imágenes del editor del blog y adjuntos/flyers de tableros.
UPLOADTHING_TOKEN=

# --- Página de Facebook + Instagram de Torneo de Rubik (web, calendar) — opcional ---
# Publicación al anunciar competencias y reintentos en /admin/redes.
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_IG_USER_ID=
